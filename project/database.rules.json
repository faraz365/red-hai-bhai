{
  "rules": {
    ".read": false,
    ".write": false,

    "buses": {
      ".read": "auth != null",
      "$busId": {
        ".write": "auth != null && root.child('drivers/' + auth.uid + '/active').val() === true && root.child('drivers/' + auth.uid + '/busId').val() === $busId",
        ".validate": "newData.hasChildren(['busId', 'routeId', 'status', 'lastUpdated'])",
        "busId":       { ".validate": "newData.isString() && newData.val() === $busId" },
        "routeId":     { ".validate": "newData.isString() && newData.val().length <= 20" },
        "latitude":    { ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90" },
        "longitude":   { ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180" },
        "speed":       { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "accuracy":    { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "status":      { ".validate": "newData.isString() && (newData.val() === 'active' || newData.val() === 'inactive')" },
        "lastUpdated": { ".validate": "newData.isNumber()" },
        "$other":      { ".validate": false }
      }
    },

    "routes": {
      ".read": "auth != null",
      ".write": false
    },

    "users": {
      ".read": "auth != null && auth.uid === $uid",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid && !data.exists()",
        ".validate": "newData.hasChildren(['name', 'email', 'role'])",
        "name":  { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 80" },
        "email": { ".validate": "newData.isString() && newData.val().length <= 200" },
        "role":  { ".validate": "newData.isString() && newData.val() === 'passenger'" },
        "$other": { ".validate": false }
      }
    },

    "drivers": {
      ".read": "auth != null",
      "$uid": {
        ".write": false
      }
    },

    "lostFound": {
      ".read": "auth != null",
      "$itemId": {
        ".write": "auth != null && !data.exists()",
        ".validate": "newData.hasChildren(['itemName', 'type', 'busId', 'routeId', 'description', 'contact', 'createdAt'])",
        "itemName":    { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 80" },
        "type":        { ".validate": "newData.isString() && (newData.val() === 'Lost' || newData.val() === 'Found')" },
        "busId":       { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20" },
        "routeId":     { ".validate": "newData.isString() && newData.val().length <= 20" },
        "description": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 300" },
        "contact":     { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 100" },
        "createdAt":   { ".validate": "newData.isNumber() || (newData.isString() && newData.val().length <= 40)" },
        "$other":      { ".validate": false }
      }
    }
  }
}
